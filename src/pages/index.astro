.hero h1 { font-size: clamp(48px, 7vw, 88px); font-weight: 400; line-height: 1.03; color: #F0EBE0; max-width: 800px; margin: 0 auto 2rem; letter-spacing: -0.01em; }
.hero h1 em { font-style: italic; color: var(--accent); }
.hero-sub { font-size: 18px; color: var(--muted); max-width: 500px; margin: 0 auto 3.5rem; line-height: 1.8; font-weight: 300; }
.hero-ctas { display: flex; gap: 1.5rem; align-items: center; justify-content: center; flex-wrap: wrap; }

.number-strip { display: grid; grid-template-columns: repeat(3, 1fr); border-bottom: 0.5px solid var(--border); }
.number-item { text-align: center; padding: 4rem 2rem; border-right: 0.5px solid var(--border); }
.number-item:last-child { border-right: none; }
.number-val { font-family: var(--serif); font-size: clamp(40px, 5vw, 60px); font-weight: 400; color: var(--accent); line-height: 1; }
.number-label { font-size: 13px; color: var(--dim); margin-top: 0.75rem; line-height: 1.5; }

.btn-primary { display: inline-block; background: var(--accent); color: #fff; padding: 0.85rem 2.25rem; font-family: var(--sans); font-size: 13px; font-weight: 500; letter-spacing: 0.06em; transition: opacity 0.2s; }
.btn-primary:hover { opacity: 0.88; }
.btn-secondary { font-size: 13px; color: var(--muted); letter-spacing: 0.04em; border-bottom: 0.5px solid rgba(138,132,122,0.4); padding-bottom: 1px; }
.btn-outline { display: inline-block; border: 0.5px solid rgba(255,255,255,0.15); color: var(--muted); padding: 0.6rem 1.5rem; font-size: 13px; font-family: var(--sans); letter-spacing: 0.06em; transition: border-color 0.2s, color 0.2s; }
.btn-outline:hover { border-color: var(--accent); color: var(--accent); }

.section { padding: 7rem 3rem; border-bottom: 0.5px solid var(--border); }
.label { font-size: 11px; letter-spacing: 0.2em; color: var(--accent); font-weight: 400; text-transform: uppercase; margin-bottom: 2.5rem; }
.section h2 { font-size: clamp(28px, 4vw, 48px); color: #F0EBE0; line-height: 1.1; margin-bottom: 2rem; letter-spacing: -0.01em; }
.section-body { color: var(--muted); font-size: 16px; max-width: 640px; line-height: 1.9; margin-bottom: 0.5rem; }

.bridge-inline { border: 0.5px solid rgba(255,255,255,0.07); padding: 2rem; margin-top: 2rem; }
.bridge-inline-header { display: flex; justify-content: space-between; gap: 1rem; align-items: flex-end; margin-bottom: 1rem; }
.bridge-inline-company { font-family: var(--serif); font-size: 28px; color: #F0EBE0; }
.bridge-inline-metrics { display: flex; gap: 0.75rem; }
.bridge-inline-metric { border: 0.5px solid var(--border); padding: 0.6rem 0.8rem; min-width: 8rem; }
.bridge-inline-metric span { display: block; font-size: 11px; color: var(--dim); margin-bottom: 0.2rem; }
.bridge-inline-metric strong { font-size: 18px; color: #E8E3D8; }
.bridge-inline-note { font-size: 12px; color: var(--dim); margin-bottom: 1rem; }
.vb-bars-vertical { display:flex; align-items:flex-end; gap:1rem; height:180px; margin:1.5rem 0; }
.vb-bar-col { display:flex; flex-direction:column; align-items:center; justify-content:flex-end; gap:4px; flex:1; }
.vb-bar-v { width:100%; border-radius:4px 4px 0 0; min-height:4px; }
.vb-bar-val { font-size:0.75rem; font-weight:500; color:var(--text); }
.vb-bar-pp { font-size:0.65rem; color:var(--dim); }
.vb-bar-nm { font-size:0.65rem; color:var(--dim); text-align:center; line-height:1.3; max-width:80px; }
.bridge-inline-bars { display: flex; flex-direction: column; gap: 0.7rem; border-top: 0.5px solid var(--border); border-bottom: 0.5px solid var(--border); padding: 1rem 0; }
.bridge-inline-row { display: grid; grid-template-columns: 220px 1fr auto; gap: 1rem; align-items: center; }
.bridge-inline-row-title { font-size: 12px; color: #C8C3B8; }
.bridge-inline-row-bar-wrap { height: 16px; background: rgba(255,255,255,0.04); }
.bridge-inline-row-bar { height: 100%; }
.bridge-inline-row-value { font-size: 12px; color: var(--accent); font-weight: 500; }
.bridge-inline-total { display: flex; justify-content: space-between; gap: 0.75rem; margin-top: 1rem; }
.bridge-inline-total span { font-size: 12px; color: var(--dim); }
.bridge-inline-total strong { font-size: 20px; color: #F0EBE0; }

.wf-legend { display: flex; gap: 1.5rem; font-size: 12px; color: var(--dim); }
.hm-legend { display: flex; gap: 1.5rem; font-size: 12px; color: var(--dim); flex-wrap: wrap; align-items: center; }

.leg-item { display: flex; align-items: center; gap: .4rem; }
.leg-dot { width: 10px; height: 10px; border-radius: 2px; flex-shrink: 0; }

.levers { display: flex; flex-direction: column; gap: .5rem; }
.lever-header { display: grid; grid-template-columns: 200px 1fr 140px 80px; gap: 1rem; padding: .5rem 1rem; font-size: 10px; letter-spacing: .1em; text-transform: uppercase; color: var(--dim); }
.lever { display: grid; grid-template-columns: 200px 1fr 140px 80px; gap: 1rem; align-items: center; padding: .875rem 1rem; border: .5px solid rgba(255,255,255,.06); }
.lname { font-size: 12px; color: #C8C3B8; }
.lbar-wrap { height: 18px; background: rgba(255,255,255,.03); }
.lbar { height: 100%; opacity: .65; }
.lval { font-size: 12px; color: var(--accent); text-align: right; font-weight: 500; }
.lroic { font-size: 12px; color: var(--accent); text-align: right; }

.bc-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 1px; background: var(--border); border: .5px solid var(--border); }
.bc { background: var(--bg); padding: 2rem 1.75rem; }
.bc-val { font-family: var(--serif); font-size: 42px; font-weight: 500; color: var(--accent); line-height: 1; margin-bottom: .5rem; }
.bc-label { font-size: 13px; color: #C8C3B8; margin-bottom: .2rem; }
.bc-sub { font-size: 11px; color: var(--dim); }

.problema-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 2.5rem; margin-top: 4rem; align-items: start; }
.pain { padding: 2rem; border-left: 1px solid var(--accent-border); }
.pain-accent { border-left-color: rgba(74,143,212,0.5); }
.pain-title { font-family: var(--serif); font-size: 20px; color: var(--accent); margin-bottom: 0.75rem; }
.pain-text { color: var(--dim); font-size: 14px; line-height: 1.8; }

.roic-formula { margin: 3rem 0; padding: 2.5rem 3.5rem; background: rgba(74,143,212,0.03); border: 0.5px solid var(--accent-border); display: inline-flex; align-items: center; gap: 2rem; }
.roic-acronym { font-family: var(--serif); font-size: 48px; color: var(--accent); font-weight: 500; }
.roic-eq { font-family: var(--serif); font-size: 40px; color: var(--muted); font-weight: 300; }
.roic-fraction { display: flex; flex-direction: column; align-items: center; gap: 0.4rem; }
.roic-num { font-size: 14px; color: #C8C3B8; }
.roic-line { width: 100%; height: 0.5px; background: var(--muted); }
.roic-den { font-size: 14px; color: var(--muted); }
.roic-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-top: 2rem; }
.palanca { background: var(--accent-dim); border: 0.5px solid var(--accent-border); padding: 2.5rem; }
.palanca-label { font-size: 11px; letter-spacing: 0.15em; color: var(--accent); text-transform: uppercase; margin-bottom: 1rem; }
.palanca-title { font-family: var(--serif); font-size: 28px; color: #F0EBE0; margin-bottom: 0.5rem; }
.palanca-items { font-size: 13px; color: var(--dim); margin-bottom: 0.75rem; }
.palanca-arrow { font-size: 12px; color: var(--accent); letter-spacing: 0.04em; }

/* Cadena secuencial */
.cadena { display: flex; align-items: flex-start; gap: 0; margin-top: 4rem; }
.cadena-bloque { flex: 1; }
.cadena-bloque-wide { flex: 1.8; }
.cadena-num-tag { font-size: 11px; letter-spacing: 0.2em; color: var(--accent); text-transform: uppercase; margin-bottom: 0.75rem; }
.cadena-card { border: 0.5px solid rgba(255,255,255,0.07); padding: 2.5rem; height: 100%; box-sizing: border-box; }
.cadena-card-split { display: flex; flex-direction: column; }
.cadena-title { font-family: var(--serif); font-size: 24px; color: #F0EBE0; margin-bottom: 0.25rem; }
.cadena-time { font-size: 12px; color: var(--accent); letter-spacing: 0.06em; margin-bottom: 1.5rem; }
.cadena-arrow { flex: 0 0 auto; align-self: center; font-size: 28px; color: var(--accent); opacity: 0.4; padding: 0 1.25rem; margin-top: 2rem; }
/* Tracks dentro de Fase 2 */
.tracks { display: flex; gap: 0; flex: 1; margin-top: 1.5rem; border-top: 0.5px solid var(--border); padding-top: 1.5rem; }
.track { flex: 1; padding-right: 1.5rem; }
.track-b { padding-right: 0; padding-left: 1.5rem; border-left: 0.5px solid rgba(255,255,255,0.07); }
.track-divider { flex: 0 0 auto; align-self: center; font-size: 11px; letter-spacing: 0.15em; color: var(--muted); text-transform: uppercase; writing-mode: vertical-rl; padding: 0 0.5rem; }
.track-label { font-size: 11px; letter-spacing: 0.15em; color: var(--accent); text-transform: uppercase; margin-bottom: 0.5rem; }
.track-title { font-family: var(--serif); font-size: 18px; color: #F0EBE0; margin-bottom: 0.25rem; }
.track-price { font-size: 13px; color: var(--accent); font-weight: 500; margin-bottom: 1.25rem; opacity: 0.8; }
/* Separador */
.cadena-separador { display: flex; align-items: center; gap: 1.5rem; margin: 4rem 0 2.5rem; }
.cadena-sep-line { flex: 1; height: 0.5px; background: rgba(255,255,255,0.07); }
.cadena-sep-texto { font-size: 11px; letter-spacing: 0.2em; color: var(--muted); text-transform: uppercase; white-space: nowrap; }
/* Due Diligence */
.dd-card { border: 0.5px solid rgba(255,255,255,0.07); padding: 2.5rem; display: flex; align-items: flex-start; gap: 3rem; }
.dd-encabezado { flex: 0 0 auto; min-width: 220px; }
.dd-titulo { font-family: var(--serif); font-size: 24px; color: #F0EBE0; margin-bottom: 0.5rem; }
.dd-tag { font-size: 11px; color: var(--accent); letter-spacing: 0.04em; opacity: 0.8; }
.dd-desc { font-size: 13px; color: var(--dim); line-height: 1.8; flex: 1; }
/* Lista de fases (reutilizada) */
.fase-list { list-style: none; padding: 0; border-top: 0.5px solid var(--border); padding-top: 1.25rem; margin-top: 1.25rem; }
.fase-list li { font-size: 13px; color: var(--dim); padding: 0.4rem 0; border-bottom: 0.5px solid rgba(255,255,255,0.03); line-height: 1.5; }
.fase-list li::before { content: "—  "; color: var(--accent); font-size: 11px; }

.levers-grid { display: grid; grid-template-columns: 1fr 2fr 1fr; gap: 2rem; margin-top: 4rem; }
.lever-group { border: 0.5px solid rgba(255,255,255,0.07); padding: 2rem; }
.lever-group-title { font-size: 11px; letter-spacing: 0.15em; text-transform: uppercase; color: var(--accent); margin-bottom: 1.25rem; padding-bottom: 0.75rem; border-bottom: 0.5px solid var(--border); }
.lever-item { font-size: 14px; color: var(--dim); padding: 0.5rem 0; border-bottom: 0.5px solid rgba(255,255,255,0.03); }

.services-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-top: 4rem; }
.service { border: 0.5px solid rgba(255,255,255,0.07); padding: 2.5rem; transition: border-color 0.2s; }
.service:hover { border-color: var(--accent-border); }
.service-num { font-family: var(--serif); font-size: 13px; color: var(--accent); margin-bottom: 1.25rem; letter-spacing: 0.1em; }
.service-title { font-family: var(--serif); font-size: 26px; color: #F0EBE0; margin-bottom: 1rem; line-height: 1.2; }
.service-desc { font-size: 13px; color: var(--dim); line-height: 1.8; margin-bottom: 1rem; }
.service-tag { font-size: 11px; color: var(--muted); letter-spacing: 0.04em; border-top: 0.5px solid var(--border); padding-top: 0.75rem; }

.resultados-nums { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; margin-top: 4rem; }
.resultado-num { text-align: center; padding: 2.5rem 2rem; background: rgba(74,143,212,0.04); border: 0.5px solid var(--accent-border); }
.resultado-val { font-family: var(--serif); font-size: 48px; font-weight: 500; color: var(--accent); line-height: 1; margin-bottom: 0.75rem; }
.resultado-label { font-size: 13px; color: var(--dim); line-height: 1.5; }
.resultados-ejemplos { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; margin-top: 1.5rem; }
.ejemplo { font-size: 13px; color: var(--dim); line-height: 1.8; padding: 1.5rem; border-left: 1px solid var(--accent-border); }
.ejemplo strong { color: #C8C3B8; font-weight: 500; }

.ahora-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; margin-top: 4rem; }
.ahora-item { padding: 2.5rem; border: 0.5px solid rgba(255,255,255,0.07); }
.ahora-num { font-family: var(--serif); font-size: 13px; color: var(--accent); margin-bottom: 1.25rem; letter-spacing: 0.1em; }
.ahora-title { font-family: var(--serif); font-size: 22px; color: #F0EBE0; margin-bottom: 1rem; line-height: 1.3; }
.ahora-text { font-size: 13px; color: var(--dim); line-height: 1.8; }

.diferenciadores-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin-top: 4rem; }
.diferenciador { padding: 2.5rem; border: 0.5px solid rgba(255,255,255,0.07); transition: border-color 0.2s; }
.diferenciador:hover { border-color: var(--accent-border); }
.dif-title { font-family: var(--serif); font-size: 22px; color: var(--accent); margin-bottom: 1rem; line-height: 1.3; }
.dif-text { font-size: 13px; color: var(--dim); line-height: 1.8; }

.blog-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; margin-top: 4rem; }
.post-card { display: block; border: 0.5px solid rgba(255,255,255,0.07); padding: 2rem; transition: border-color 0.2s, background 0.2s; }
.post-card:hover { border-color: var(--accent-border); background: rgba(74,143,212,0.02); }
.post-tag { font-size: 10px; letter-spacing: 0.15em; text-transform: uppercase; color: var(--accent); margin-bottom: 1rem; }
.post-title { font-family: var(--serif); font-size: 22px; color: #E8E3D8; line-height: 1.3; margin-bottom: 0.75rem; }
.post-excerpt { font-size: 13px; color: #5A5450; line-height: 1.7; margin-bottom: 1.5rem; }
.post-meta { display: flex; justify-content: space-between; font-size: 11px; color: #5A5450; border-top: 0.5px solid var(--border); padding-top: 0.75rem; }
.post-read { color: var(--accent); }
.blog-cta { margin-top: 2.5rem; }

.demo-card { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; margin-top: 3rem; border: 0.5px solid rgba(74,143,212,0.25); padding: 2.5rem; background: rgba(74,143,212,0.03); }
.demo-tag { font-size: 11px; letter-spacing: 0.15em; text-transform: uppercase; color: var(--accent); margin-bottom: 0.75rem; }
.demo-company { font-family: var(--serif); font-size: 32px; color: #F0EBE0; margin-bottom: 0.5rem; }
.demo-desc { font-size: 13px; color: var(--dim); margin-bottom: 2rem; }
.demo-hallazgos { display: flex; flex-direction: column; gap: 1rem; }
.demo-hallazgo { display: flex; gap: 1rem; align-items: flex-start; }
.demo-hallazgo-num { font-family: var(--serif); font-size: 13px; color: var(--accent); flex-shrink: 0; letter-spacing: 0.1em; }
.demo-hallazgo-text { font-size: 13px; color: var(--dim); line-height: 1.6; }
.demo-right { border-left: 0.5px solid rgba(74,143,212,0.2); padding-left: 3rem; display: flex; flex-direction: column; }
.demo-impacto-label { font-size: 11px; letter-spacing: 0.15em; text-transform: uppercase; color: var(--muted); margin-bottom: 0.5rem; }
.demo-impacto-val { font-family: var(--serif); font-size: 64px; color: var(--accent); font-weight: 400; line-height: 1; margin-bottom: 0.25rem; }
.demo-impacto-sub { font-size: 13px; color: var(--dim); margin-bottom: 2rem; }
.demo-items { display: flex; flex-direction: column; gap: 1rem; margin-bottom: 2rem; flex: 1; }
.demo-item { display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; padding: 0.75rem 0; border-bottom: 0.5px solid rgba(255,255,255,0.05); }
.demo-item-desc { font-size: 13px; color: var(--dim); line-height: 1.5; }
.demo-item-val { font-family: var(--serif); font-size: 18px; color: var(--accent); flex-shrink: 0; }
.btn-demo { display: inline-block; background: var(--accent); color: #fff; padding: 0.85rem 2rem; font-family: var(--sans); font-size: 13px; font-weight: 500; letter-spacing: 0.06em; transition: opacity 0.2s; text-align: center; }
.btn-demo:hover { opacity: 0.88; }

.about-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 5rem; align-items: start; }
.avatar { width: 80px; height: 80px; border-radius: 50%; background: var(--accent-dim); border: 0.5px solid var(--accent-border); display: flex; align-items: center; justify-content: center; font-family: var(--serif); font-size: 26px; color: var(--accent); margin-bottom: 1.5rem; }
.about-name { font-family: var(--serif); font-size: 32px; color: #F0EBE0; margin-bottom: 0.25rem; }
.about-role { font-size: 13px; color: var(--dim); margin-bottom: 1.5rem; }
.about-bio { font-size: 15px; color: var(--dim); line-height: 1.9; max-width: 400px; }
.exp-group { margin-bottom: 2.5rem; }
.exp-group-label { font-size: 11px; letter-spacing: 0.15em; color: #5A5450; text-transform: uppercase; margin-bottom: 1.25rem; }
.exp-item { padding: 0.85rem 0; border-bottom: 0.5px solid var(--border); }
.exp-item.last { border: none; }
.exp-company { font-size: 13px; color: var(--accent); margin-bottom: 0.2rem; }
.exp-role { font-size: 13px; color: var(--dim); line-height: 1.6; }

.pasos-grid { display: flex; align-items: flex-start; gap: 1rem; margin-top: 4rem; }
.paso { flex: 1; border: 0.5px solid rgba(255,255,255,0.07); padding: 2.5rem; }
.paso-sep { font-family: var(--serif); font-size: 24px; color: var(--accent); opacity: 0.4; padding-top: 2rem; flex-shrink: 0; }
.paso-num { font-family: var(--serif); font-size: 44px; color: var(--accent); opacity: 0.25; line-height: 1; margin-bottom: 1rem; }
.paso-title { font-family: var(--serif); font-size: 20px; color: #F0EBE0; margin-bottom: 0.5rem; line-height: 1.3; }
.paso-text { font-size: 13px; color: var(--dim); line-height: 1.8; }

.cta-section { text-align: center; padding: 10rem 3rem; }
.cta-section h2 { font-size: clamp(40px, 6vw, 72px); color: #F0EBE0; margin-bottom: 1.25rem; max-width: 700px; margin-left: auto; margin-right: auto; line-height: 1.05; letter-spacing: -0.01em; }
.cta-sub { color: var(--dim); font-size: 15px; letter-spacing: 0.04em; margin-bottom: 3rem; }
.contact-form { max-width: 600px; margin: 0 auto; text-align: left; }
.form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1rem; }
.form-group { display: flex; flex-direction: column; gap: 0.4rem; margin-bottom: 1rem; }
.form-group label { font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
.form-group input, .form-group textarea { background: rgba(255,255,255,0.03); border: 0.5px solid rgba(255,255,255,0.12); color: var(--text); padding: 0.75rem 1rem; font-family: var(--sans); font-size: 14px; font-weight: 300; outline: none; transition: border-color 0.2s; resize: vertical; }
.form-group input::placeholder, .form-group textarea::placeholder { color: #4A4440; }
.form-group input:focus, .form-group textarea:focus { border-color: var(--accent); }
.btn-submit { width: 100%; background: var(--accent); color: #fff; border: none; padding: 0.9rem 2rem; font-family: var(--sans); font-size: 14px; font-weight: 500; letter-spacing: 0.06em; cursor: pointer; transition: opacity 0.2s; margin-top: 0.5rem; }
.btn-submit:hover { opacity: 0.88; }
.contact-alt { margin-top: 1.5rem; font-size: 13px; color: #4A4440; }
.contact-alt a { color: var(--accent); border-bottom: 0.5px solid var(--accent-border); }
.gracias { max-width: 600px; margin: 0 auto; padding: 3rem 2rem; border: 0.5px solid var(--accent-border); background: rgba(74,143,212,0.04); text-align: center; }
.gracias-titulo { font-family: var(--serif); font-size: 28px; color: #F0EBE0; margin-bottom: 1rem; line-height: 1.3; }
.gracias-sub { font-size: 14px; color: var(--dim); line-height: 1.7; }

@media (max-width: 900px) {
  .levers-grid, .ahora-grid, .resultados-nums, .resultados-ejemplos { grid-template-columns: 1fr; }
  .cadena { flex-direction: column; }
  .cadena-arrow { align-self: flex-start; transform: rotate(90deg); padding: 0.5rem 0; margin: 0; }
  .cadena-bloque, .cadena-bloque-wide { flex: unset; width: 100%; }
  .dd-card { flex-direction: column; gap: 1.25rem; }
  .pasos-grid { flex-direction: column; }
  .paso-sep { display: none; }
  .number-strip { grid-template-columns: 1fr; }
  .number-item { border-right: none; border-bottom: 0.5px solid var(--border); }
}
@media (max-width: 768px) {
  .hero { padding: 5rem 1.5rem 4rem; text-align: left; }
  .hero-ctas { justify-content: flex-start; }
  .bridge-inline-header { flex-direction: column; align-items: flex-start; }
  .bridge-inline-metrics { flex-wrap: wrap; }
